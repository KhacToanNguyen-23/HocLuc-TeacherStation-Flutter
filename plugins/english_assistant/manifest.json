{
  "$schema": "https://hocluc.edu.vn/schemas/plugin-manifest-v2.1.json",
  "id": "com.hocluc.plugin.english",
  "name": "Trợ giảng Tiếng Anh",
  "version": "2.1.4",
  "author": "Học Lực Studio",
  "description": "Bóc tách cú pháp S-V-O và phân tích ngữ liệu ĐGNL.",
  "category": "languages",
  "icon": "icon.png",
  "ui": {
    "entry": "ui/index.html",
    "placement": "bottom_drawer",
    "default_width": 420,
    "default_height": 520,
    "resizable": true,
    "frameless": false,
    "inject_sdk": true,
    "transparent_background": true
  },
  "contributes": {
    "tools": [
      {
        "id": "snip_passage",
        "label": "Quét đoạn văn",
        "icon": "crop_free",
        "tooltip": "Chụp đoạn văn trên đề để phân tích trực tiếp.",
        "action": "snip_region",
        "target": "dgnl",
        "key": "quick_snip_dgnl_button"
      },
      {
        "id": "svo",
        "label": "Công cụ S-V-O",
        "icon": "auto_awesome",
        "tooltip": "Bật công cụ bóc tách S-V-O.",
        "action": "toggle_tool",
        "target": "svo",
        "captures_board_input": true,
        "key": "svo_tool_button"
      },
      {
        "id": "quick_sentence",
        "label": "Nhập câu",
        "icon": "edit_note",
        "tooltip": "Nhập hoặc chọn câu tiếng Anh để phân tích.",
        "action": "quick_input",
        "key": "quick_sentence_button"
      }
    ]
  },
  "backend": {
    "type": "python",
    "entry": "engine/service.py",
    "health_endpoint": "/health"
  },
  "permissions": [
    "board:insert_annotation",
    "board:read_text",
    "storage"
  ]
}

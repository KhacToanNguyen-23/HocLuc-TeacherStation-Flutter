{
  "$schema": "https://hocluc.edu.vn/schemas/plugin-manifest-v2.1.json",
  "id": "com.hocluc.plugin.english",
  "name": "Trợ giảng Tiếng Anh",
  "version": "2.1.4",
  "author": "Học Lực Studio",
  "description": "Phân tích từ vựng, ngữ pháp và collocation cho giáo viên.",
  "category": "languages",
  "icon": "icon.png",
  "ui": {
    "entry": "ui/index.html",
    "placement": "bottom_drawer",
    "default_width": 420,
    "default_height": 520,
    "resizable": true,
    "frameless": false,
    "inject_sdk": true,
    "transparent_background": true
  },
  "contributes": {
    "tools": [
      {
        "id": "snip_passage",
        "label": "Quét đoạn văn",
        "icon": "crop_free",
        "tooltip": "Chụp đoạn văn trên đề để phân tích trực tiếp.",
        "action": "snip_region",
        "target": "dgnl",
        "key": "quick_snip_dgnl_button"
      }
    ]
  },
  "backend": {
    "type": "binary",
    "entry": "engine/bin/english_assistant_engine.exe",
    "development_entry": "engine/dart/bin/english_assistant_engine.dart",
    "health_endpoint": "/health"
  },
  "permissions": [
    "board:insert_annotation",
    "board:read_text",
    "storage"
  ]
}

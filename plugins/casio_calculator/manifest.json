{
  "$schema": "https://hocluc.com/schemas/plugin.v2.json",
  "id": "com.hocluc.plugin.casio",
  "name": "Máy Tính Khoa Học Casio",
  "version": "1.1.1",
  "author": "Học Lực Math Team",
  "description": "Mô phỏng máy tính khoa học Casio FX-580 / FX-880 hỗ trợ giải toán và tính toán trên bảng phấn.",
  "category": "math",
  "main": "ui/index.html",
  "icon": "icon.png",
  "placement": "floating_window",
  "default_width": 336,
  "default_height": 624,
  "resizable": false,
  "frameless": true,
  "inject_sdk": true,
  "backend": null,
  "contributes": {
    "tools": []
  },
  "permissions": [
    "board:insert_annotation"
  ]
}

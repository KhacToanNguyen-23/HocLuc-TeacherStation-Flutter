{
  "$schema": "https://hocluc.edu.vn/schemas/plugin-manifest-v2.1.json",
  "id": "com.hocluc.plugin.math_studio",
  "name": "Học Lực Math Studio",
  "version": "2.1.0",
  "author": "Học Lực Math Engineering Team",
  "description": "Studio Toán học Sư phạm: Đồ thị hàm số & Khảo sát, Bảng biến thiên, Tích phân Riemann & Khối tròn xoay 3D.",
  "category": "math",
  "icon": "icon.png",
  "ui": {
    "entry": "ui/index.html",
    "placement": "modal",
    "movable": false,
    "default_width": 1080,
    "default_height": 640,
    "resizable": true,
    "frameless": true,
    "inject_sdk": true
  },
  "backend": null,
  "contributes": {
    "tools": [
      {
        "id": "open_math_studio",
        "label": "Đồ thị hàm số",
        "icon": "functions",
        "action": "toggle_tool"
      }
    ]
  },
  "permissions": [
    "board:insert_annotation"
  ]
}

# Shared backend Google OAuth configuration. Copy to .env and supply your values.
# Workspace integration defaults to this same client; no duplicate IDs needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides:
# HOC_LUC_GOOGLE_CLIENT_ID=
# HOC_LUC_GOOGLE_CLIENT_SECRET=
# HOC_LUC_GOOGLE_ENCRYPTION_KEY=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:47831/api/auth/google/callback
# HOC_LUC_GOOGLE_REDIRECT_URI=http://127.0.0.1:47831/api/integrations/google/callback
